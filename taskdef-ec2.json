{
    "containerDefinitions":  [
                                 {
                                     "name":  "three-tier-cont",
                                     "image":  "\u003cIMAGE1_NAME\u003e",
                                     "cpu":  0,
                                     "portMappings":  [
                                                          {
                                                              "containerPort":  80,
                                                              "hostPort":  80,
                                                              "protocol":  "tcp",
                                                              "name":  "three-tier-cont-80-tcp",
                                                              "appProtocol":  "http"
                                                          }
                                                      ],
                                     "essential":  true,
                                     "environment":  [

                                                     ],
                                     "environmentFiles":  [

                                                          ],
                                     "mountPoints":  [

                                                     ],
                                     "volumesFrom":  [

                                                     ],
                                     "secrets":  [
                                                     {
                                                         "name":  "DB_HOST",
                                                         "valueFrom":  "arn:aws:ssm:eu-north-1:236172119834:parameter/three-tier/db-host"
                                                     },
                                                     {
                                                         "name":  "DB_NAME",
                                                         "valueFrom":  "arn:aws:ssm:eu-north-1:236172119834:parameter/three-tier/db-name"
                                                     },
                                                     {
                                                         "name":  "DB_PASSWORD",
                                                         "valueFrom":  "arn:aws:ssm:eu-north-1:236172119834:parameter/three-tier/db-password"
                                                     },
                                                     {
                                                         "name":  "DB_USER",
                                                         "valueFrom":  "arn:aws:ssm:eu-north-1:236172119834:parameter/three-tier/db-user"
                                                     }
                                                 ],
                                     "ulimits":  [

                                                 ],
                                     "logConfiguration":  {
                                                              "logDriver":  "awslogs",
                                                              "options":  {
                                                                              "awslogs-group":  "/ecs/three-tier-task",
                                                                              "awslogs-create-group":  "true",
                                                                              "awslogs-region":  "eu-north-1",
                                                                              "awslogs-stream-prefix":  "ecs"
                                                                          },
                                                              "secretOptions":  [

                                                                                ]
                                                          },
                                     "healthCheck":  {
                                                         "command":  [
                                                                         "CMD-SHELL",
                                                                         "wget -q -O - http://127.0.0.1/health || exit 1"
                                                                     ],
                                                         "interval":  30,
                                                         "timeout":  5,
                                                         "retries":  3,
                                                         "startPeriod":  60
                                                     },
                                     "systemControls":  [

                                                        ]
                                 }
                             ],
    "family":  "three-tier-task",
    "executionRoleArn":  "arn:aws:iam::236172119834:role/ecsTaskExecutionRole",
    "networkMode":  "awsvpc",
    "volumes":  [

                ],
    "placementConstraints":  [

                             ],
    "runtimePlatform":  {
                            "cpuArchitecture":  "X86_64",
                            "operatingSystemFamily":  "LINUX"
                        },
    "requiresCompatibilities":  [
                                    "EC2"
                                ],
    "cpu":  "512",
    "memory":  "512",
    "enableFaultInjection":  false
}
